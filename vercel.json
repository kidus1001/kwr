{
  "redirects": [
    {
      "source": "/Begena/assets/:path*",
      "destination": "https://echoes-du-begena.vercel.app/assets/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/Begena",
      "destination": "https://echoes-du-begena.vercel.app"
    },
    {
      "source": "/Begena/:path*",
      "destination": "https://echoes-du-begena.vercel.app/:path*"
    }
  ]
}
